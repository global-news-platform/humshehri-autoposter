# ======================================================
# Humshehri Facebook Auto-Poster configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ======================================================

# --- Facebook --------------------------------------------------
# Your Facebook Page ID (numeric). Defaults to the Humshehri page.
FACEBOOK_PAGE_ID=100071825280252

# Long-lived (non-expiring) Facebook Page Access Token.
# See README.md for the step-by-step guide to generate one.
FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_your_long_lived_page_access_token

# --- Article source ---------------------------------------------
# RSS feed is tried first; the WordPress REST API is used as a fallback.
RSS_FEED_URL=https://humshehri.pk/feed/
WP_API_URL=https://humshehri.pk/wp-json/wp/v2/posts

# --- Scheduling ---------------------------------------------------
# "preset"  -> pick a random delay from INTERVALS_MIN
# "random"  -> pick a random delay between MIN_INTERVAL_MIN and MAX_INTERVAL_MIN
SCHEDULE_MODE=preset

# Preset intervals (minutes) used in "preset" mode.
INTERVALS_MIN=3,5,7,11,13,17,21,27

# Bounds (minutes) used in "random" mode.
MIN_INTERVAL_MIN=3
MAX_INTERVAL_MIN=30

# How long to wait (minutes) before re-checking the source when there are
# no new articles to post.
POLL_INTERVAL_MIN=30

# --- Storage ------------------------------------------------------
# "sqlite" -> local SQLite database (posted_articles.db)
# "json"   -> local JSON file (posted_articles.json)
STORAGE=sqlite
DB_PATH=posted_articles.db

# --- Posting ------------------------------------------------------
# Attach the article's featured image when available (falls back to a
# text/link post when the image is missing or fails).
POST_WITH_IMAGE=true

# --- Network / retries ---------------------------------------------
HTTP_TIMEOUT=20
MAX_RETRIES=3

# Number of failed publish attempts before an article is marked "skipped"
# so a permanently broken article does not block the queue forever.
MAX_POST_ATTEMPTS=3

# --- Logging -------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
