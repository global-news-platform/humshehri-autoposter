# ======================================================
# Humshehri Facebook Auto-Poster configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ======================================================

# --- Facebook --------------------------------------------------
# Your Facebook Page ID (numeric). Defaults to the Humshehri page.
FACEBOOK_PAGE_ID=100071825280252

# Long-lived (non-expiring) Facebook Page Access Token.
# See README.md for the step-by-step guide to generate one.
FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_your_long_lived_page_access_token

# --- Article source ---------------------------------------------
# Discovery sources. RSS is parsed first and the WordPress REST API runs
# alongside it (never just a fallback), so articles the feed misses or
# mis-numbers are still found. The WordPress site's pretty `/feed/` and
# `/wp-json/` paths are 404-protected by the server, so the bot uses the
# standard query-parameter equivalents (`?feed=rss2`, `?rest_route=...`)
# which expose the exact same feed and REST API.
RSS_FEED_URL=https://humshehri.online/?feed=rss2
WP_API_URL=https://humshehri.online/?rest_route=/wp/v2/posts

# Supplementary WordPress REST API discovery and lookback page size.
ENABLE_WP_API_DISCOVERY=true
WP_API_LOOKBACK=20

# --- Scheduling ---------------------------------------------------
# "preset"  -> pick a random delay from INTERVALS_MIN
# "random"  -> pick a random delay between MIN_INTERVAL_MIN and MAX_INTERVAL_MIN
SCHEDULE_MODE=preset

# Preset intervals (minutes) used in "preset" mode.
INTERVALS_MIN=3,5,7,11,13,17,21,27

# Bounds (minutes) used in "random" mode.
MIN_INTERVAL_MIN=3
MAX_INTERVAL_MIN=30

# How long to wait (minutes) before re-checking the source when there are
# no new articles to post.
POLL_INTERVAL_MIN=30

# --- Storage ------------------------------------------------------
# "sqlite" -> local SQLite database (posted_articles.db)
# "json"   -> local JSON file (posted_articles.json)
STORAGE=sqlite
DB_PATH=posted_articles.db

# --- Posting ------------------------------------------------------
# Posts each article as a NATIVE Facebook photo post: the article's own image
# is downloaded and uploaded as a real photo file, and the article is shared
# as an EXACT COPY — original title + complete original body, verbatim, with no
# AI rewriting, no truncation and no URL scrubbing. Hashtags, when enabled (see
# the Hashtags section below), are appended only AFTER the article text and
# never inserted into it. URLs that are genuinely part of the article body are
# preserved. Facebook never fetches the website, so there is no link preview or
# clickable link.
POST_WITH_IMAGE=true

# Publish an article ONLY if its own image was found and downloaded. When true,
# articles with no usable image are safety-skipped (never posted and never left
# image-less). When false, image-less articles are posted as text-only.
REQUIRE_ARTICLE_IMAGE=true

# No AI rewriting is ever applied — USE_AI_REWRITING=false is the enforced
# behavior. Kept for clarity/forward-compat; do not enable.
USE_AI_REWRITING=false

# Open the article's own page and copy its text directly from the full page
# (authoritative). When false the RSS/API excerpt is used instead.
PREFER_FULL_ARTICLE_PAGE=true

# Strict extraction mode: if the full article page can't be fetched or its text
# is too short (looks like navigation/menus instead of an article), the article
# is safety-skipped rather than posted with wrong/empty text.
STRICT_ARTICLE_EXTRACTION=true

# Minimum article body length (characters) for the text to be trusted as an
# article in strict mode.
MIN_ARTICLE_CHARS=120

# --- Hashtags ------------------------------------------------------
# ON by default. Keyword-relevant hashtags (Urdu + English mix) are generated
# from curated topic rules and appended as a separate layer AFTER the exact
# article text (a blank line separates them). The article title/body is never
# modified: hashtags are sanitized/deduplicated, and reduced one at a time if
# the combined caption nears Facebook's character limit (the article itself is
# never truncated). Set ADD_HASHTAGS=false to post the exact article only.
ADD_HASHTAGS=true
# Maximum number of hashtags appended per post (3-7 recommended).
MAX_HASHTAGS=7

# --- Network / retries ---------------------------------------------
HTTP_TIMEOUT=20
MAX_RETRIES=3

# Number of failed publish attempts before an article is marked "skipped"
# so a permanently broken article does not block the queue forever.
MAX_POST_ATTEMPTS=3

# --- Logging -------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO